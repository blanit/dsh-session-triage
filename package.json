{
  "name": "@local/dsh-session-triage",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Switchable inbox-style session sidebar for DeepSeek Harness",
  "license": "MIT",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": { "build": "node build.mjs", "test": "node --test test/*.test.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-context-menu", "@deepseek-ai/dsh-client-locale"] }
  }
}
